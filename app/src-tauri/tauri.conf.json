{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotePDF",
  "version": "0.1.0",
  "identifier": "com.notepdf.desktop",
  "build": {
    "frontendDist": "../../src/notepdf/gui/dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NotePDF",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Productivity",
    "shortDescription": "Highlights and comments for PDFs",
    "longDescription": "Add highlights and comments to PDFs by selecting text or from a config file, and turn LaTeX revision markers into highlights in the compiled PDF.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
